# Secretos de Lobster — copiar a /etc/lobster/.env y rellenar.
# NUNCA commitear el .env real. Permisos recomendados: 0640 root:openclaw.

# =========================
# Telegram approval bot
# =========================

# Activa o desactiva el bot de Telegram.
# true  = Lobster escucha comandos y puede pedir aprobaciones.
# false = Lobster no usa Telegram.
LOBSTER_TELEGRAM__ENABLED=true

# Token privado del bot creado con BotFather.
# Es un secreto: no subir a Git, no pegar en documentación ni capturas.
LOBSTER_TELEGRAM__BOT_TOKEN=REPLACE_WITH_BOTFATHER_TOKEN

# Lista de IDs numéricos de Telegram autorizados para controlar Lobster.
# No es el username. Sacarlo con @userinfobot o @RawDataBot.
# Para el TFG: dejar sólo el ID del propietario.
LOBSTER_TELEGRAM__ALLOWED_USER_IDS=[REPLACE_WITH_NUMERIC_TELEGRAM_USER_ID]

# Tiempo máximo que el long polling de Telegram espera respuesta por ciclo.
# 30s es un valor equilibrado: reactivo sin hacer demasiadas peticiones.
LOBSTER_TELEGRAM__POLLING_TIMEOUT_SECONDS=30


# =========================
# Approval queue
# =========================

# Tiempo de espera inicial para acciones NO críticas antes de repreguntar.
# 900s = 15 minutos.
LOBSTER_APPROVAL__DEFAULT_TIMEOUT_SECONDS=900

# Tiempo total tras el cual una acción NO crítica pendiente se cancela.
# 7200s = 2 horas.
LOBSTER_APPROVAL__DEFAULT_CANCEL_AFTER_SECONDS=7200

# Tiempo de espera inicial para acciones críticas antes del primer recordatorio.
# 150s. Las acciones críticas NO deberían autocancelarse; deben quedar pendientes.
LOBSTER_APPROVAL__CRITICAL_TIMEOUT_SECONDS=150

# Intervalo entre recordatorios de acciones críticas pendientes.
# 60s = Lobster repregunta cada minuto hasta recibir aprobación/rechazo.
LOBSTER_APPROVAL__CRITICAL_REMINDER_INTERVAL_SECONDS=60

# Límite máximo de acciones pendientes en cola.
# Evita acumulación infinita si hay un bug, spam de eventos o Telegram caído.
LOBSTER_APPROVAL__MAX_PENDING_APPROVALS=50
