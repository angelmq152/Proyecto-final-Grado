apiVersion: v1
kind: Config
clusters:
  - name: saasphere
    cluster:
      # CA del cluster K3s (base64). Generar con:
      #   ssh angel@matrix "sudo cat /var/lib/rancher/k3s/server/tls/server-ca.crt | base64 -w0"
      certificate-authority-data: REPLACE_WITH_BASE64_CA
      server: https://192.168.1.202:6443
users:
  - name: openclaw-reader
    user:
      # Token del ServiceAccount con permisos limitados.
      # Crear en Matrix con el manifest:
      #   ../../../Matrix/opt/k3s/leia-rbac.yaml
      # Después extraer con:
      #   kubectl -n kube-system create token openclaw-reader --duration=8760h
      token: REPLACE_WITH_SERVICEACCOUNT_TOKEN
contexts:
  - name: openclaw-reader@saasphere
    context:
      cluster: saasphere
      user: openclaw-reader
current-context: openclaw-reader@saasphere
