global:
  resolve_timeout: 5m

route:
  group_by: ['alertname', 'instance']
  group_wait: 30s
  group_interval: 5m
  repeat_interval: 12h
  receiver: telegram
  routes:
    - receiver: telegram
      continue: true
    - receiver: openclaw
      continue: true

receivers:
  - name: telegram
    telegram_configs:
      - bot_token: 'YOUR_TELEGRAM_BOT_TOKEN'    # @BotFather → /newbot
        chat_id: YOUR_TELEGRAM_CHAT_ID          # ID del chat/grupo destinatario
        message: |
          🚨 *{{ .Status | toUpper }}* — {{ .CommonLabels.alertname }}
          📍 *Nodo:* {{ .CommonLabels.instance }}
          📝 {{ .CommonAnnotations.summary }}
          {{ if eq .Status "resolved" }}✅ Recuperado{{ end }}
        parse_mode: Markdown

  - name: openclaw
    webhook_configs:
      - url: 'http://192.168.1.200:8080/webhook/alert'   # LeIA → Lobster /webhook/alert
        send_resolved: true
